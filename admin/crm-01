  ],next:()=>'requirement'},

  salaryjob:{title:'Employment details',fields:[
    {key:'employerType',label:'Employer type',type:'select',trigger:true,options:['Government','Big private factory','Small factory / firm','Other']},
    {key:'otherEmployerName',label:'Other employer type',type:'text',showIf:s=>s.employerType==='Other'},
    {key:'companyLocation',label:'Company / firm location',type:'text'},
