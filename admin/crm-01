let lenders=loadLenders();
function lenderById(id){ return lenders.find(l=>l.id===id); }
function productKey(lid,idx){ return lid+'::'+idx; }
function productByKey(key){
  const [lid,idx]=String(key).split('::'); const l=lenderById(lid);
  if(!l||!l.products[idx]) return null;
  return {lender:l,product:l.products[idx],key:key};
}
function lenderOptionsFor(loanType){
  const out=[];
  lenders.forEach(l=>l.products.forEach((p,i)=>{ if(p.type===loanType) out.push({lender:l,product:p,key:productKey(l.id,i)}); }));
  return out;
}

/* amount range parsing: "5L - 50L", "30L+", "50K - 2L", "3L - 3CR" */
function parseUnit(tok){
  const m=String(tok).toUpperCase().match(/([\d.]+)\s*(CR|L|K)?/);
  if(!m) return null;
  let n=parseFloat(m[1]); const u=m[2]||'';
  if(u==='CR') n*=1e7; else if(u==='L') n*=1e5; else if(u==='K') n*=1e3;
  return n;
}
function rangeFit(rangeStr,amount){
  if(!rangeStr||!amount) return null;
  const s=String(rangeStr).toUpperCase();
  const parts=s.match(/[\d.]+\s*(?:CR|L|K)?/g);
  if(!parts||!parts.length) return null;
  const min=parseUnit(parts[0]);
  let max=parts[1]?parseUnit(parts[1]):null;
  if(s.includes('+')&&!parts[1]) max=Infinity;
  if(min===null) return null;
  if(max===null) max=Infinity;
  return amount>=min&&amount<=max;
}

