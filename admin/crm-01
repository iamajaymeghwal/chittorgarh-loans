}
</script>

<script>
/* ================= LEAD DETAIL ================= */
const ACTION_LABELS={'Basic Details':'Fill the basic details form','Docs Collection':'Open document checklist',
 'Lenders Suggestion':'See lenders for this loan','Eligible Lenders':'Shortlist eligible lenders',
 'Logined':'Record a lender login','Sanctioned':'Enter sanction details','Commission Got':'Record the payout',
 'Disbursed':'Mark as disbursed','Closed':'Close this file','Not Eligible':'Mark not eligible'};
let openLeadId=null, openBlocks={};
function leadById(id){ return leads.find(l=>l.id===id); }

function stepperHTML(l){
  const idx=stageIndex(l.stage);
  if(l.stage==='Not Eligible') return `<div class="stepper"><span class="step bad">Not eligible</span>${FLOW_STAGES.map(s=>`<span class="step">${esc(s)}</span>`).join('')}</div>`;
  return `<div class="stepper">${FLOW_STAGES.map((s,i)=>`<span class="step ${i<idx?'done':i===idx?'cur':''}">${esc(s)}</span>`).join('')}</div>`;
}
function nextStageOf(l){
  if(TERMINAL_STAGES.includes(l.stage)) return null;
  const i=stageIndex(l.stage);
  return i>=0&&i<FLOW_STAGES.length-1?FLOW_STAGES[i+1]:null;
}
function blockHTML(id,title,badge,body,openDefault){
  const open=openBlocks[id]!==undefined?openBlocks[id]:!!openDefault;
  return `<div class="blk"><div class="blk-head" data-blk="${id}">
      <div class="bh-l"><h4>${esc(title)}</h4>${badge?`<span class="blk-badge">${esc(badge)}</span>`:''}</div>
      <span style="color:var(--muted);font-size:12px">${open?'Hide':'Show'}</span>
    </div>${open?`<div class="blk-body">${body}</div>`:''}</div>`;
}
function kv(k,v){ return `<div class="kv"><span class="k">${esc(k)}</span><span class="v">${esc(v||'—')}</span></div>`; }

function openDetail(id){
  openLeadId=id; const l=leadById(id); if(!l) return;
  document.getElementById('detailTitle').textContent=l.name;
  renderDetail(); openSheet('detailOverlay');
}
function renderDetail(){
  const l=leadById(openLeadId); if(!l) return;
  const nxt=nextStageOf(l);
  const nxtDef=nxt?STAGES.find(s=>s.k===nxt):null;
  const docs=docChecklistFor(l); const allDocs=docs.reduce((a,g)=>a.concat(g.items),[]);
  const doneDocs=allDocs.filter(d=>l.docs[d]).length;

  const action=l.stage==='Not Eligible'
    ? `<div class="stage-action" style="background:linear-gradient(135deg,#8C2F2F,#C0463C)">
        <div class="sa-lbl">Current stage</div><div class="sa-title">Not eligible</div>
        <div class="sa-desc">${esc((l.notEligible&&l.notEligible.reason)||'No reason recorded yet.')}</div>
        <button class="btn btn-ghost" data-stageform="Not Eligible">Edit reason</button>
        <button class="btn btn-ghost" style="margin-top:8px" data-reopen="1">Reopen this lead</button>
      </div>`
    : l.stage==='Closed'
    ? `<div class="stage-action" style="background:linear-gradient(135deg,var(--green-dark),var(--green))">
        <div class="sa-lbl">Current stage</div><div class="sa-title">File closed</div>
        <div class="sa-desc">${esc((l.closure&&l.closure.reason)||'Closed and archived.')}</div>
        <button class="btn btn-ghost" data-reopen="1">Reopen this lead</button>
      </div>`
    : `<div class="stage-action">
        <div class="sa-lbl">Now at · ${esc(l.stage)}</div>
        <div class="sa-title">${esc(nxt||l.stage)}</div>
        <div class="sa-desc">${esc(nxtDef?nxtDef.d:'')}</div>
        <button class="btn btn-gold" data-stageform="${esc(nxt||'')}">${esc(ACTION_LABELS[nxt]||'Continue')}</button>
      </div>`;

  const body=`
    <div class="card" style="margin-bottom:12px">
      <div class="lc-top">
        <div class="avatar">${esc(initials(l.name))}</div>
        <div style="flex:1;min-width:0">
          <div class="lc-name">${esc(l.name)}</div>
          <div class="lc-meta">${esc(l.phone||'No number')}${l.city?' · '+esc(l.city):''}</div>
        </div>
        <div class="lc-amt">${money(l.amount)}<small>${esc(l.loanType.replace(' (LAP)',''))}</small></div>
      </div>
      <div class="btn-row" style="margin-top:12px">
        <button class="btn btn-ghost btn-sm" data-call="${esc(l.phone)}">📞 Call</button>
        <button class="btn btn-ghost btn-sm" data-wa="${esc(l.phone)}">💬 WhatsApp</button>
        <button class="btn btn-ghost btn-sm" data-editlead="1">Edit</button>
      </div>
    </div>

    ${stepperHTML(l)}
    ${action}

    <div class="card" style="margin-bottom:12px">
      <div class="field" style="margin-bottom:10px">
        <label>Disposition</label>
        <div class="chip-row wrap" id="dispoPick">
          ${DISPOSITIONS.map(d=>`<div class="chip ${l.disposition===d?'active':''}" data-dispo="${esc(d)}">${esc(d)}</div>`).join('')}
        </div>
      </div>
      <div class="field-row">
        <div class="field" style="margin-bottom:0"><label>Next follow-up</label><input type="date" id="fuDate" value="${l.followUpAt||''}"></div>
        <div class="field" style="margin-bottom:0"><label>Stage</label>
          <select id="stagePick">${STAGE_KEYS.map(s=>`<option ${l.stage===s?'selected':''}>${esc(s)}</option>`).join('')}</select>
        </div>
      </div>
      <div class="field" style="margin:12px 0 0"><label>Add a note</label><textarea id="noteBox" placeholder="What did the customer say?"></textarea>
        <button class="btn btn-ghost btn-sm" id="addNoteBtn" style="margin-top:8px;width:100%">Save note</button>
      </div>
    </div>

    ${blockHTML('basic','Basic details',Object.keys(l.profile).length?'Filled':'Pending',basicBlockHTML(l))}
    ${blockHTML('docs','Documents',`${doneDocs}/${allDocs.length}`,docsBlockHTML(l,docs,allDocs,doneDocs))}
    ${blockHTML('sugg','Suggested lenders',String(l.suggested.length),listBlockHTML(l.suggested,'No lenders suggested yet.'))}
    ${blockHTML('elig','Eligible lenders',String(l.eligible.length),listBlockHTML(l.eligible,'No lender shortlisted yet.'))}
    ${blockHTML('login','Logins',String(l.logins.length),loginBlockHTML(l))}
    ${blockHTML('sanc','Sanction',l.sanction?money(l.sanction.amount):'—',sancBlockHTML(l))}
    ${blockHTML('comm','Commission',l.commission?money(l.commission.amount):'—',commBlockHTML(l))}
    ${blockHTML('disb','Disbursal',l.disbursal?money(l.disbursal.amount):'—',disbBlockHTML(l))}
    ${blockHTML('tl','Activity',String(l.timeline.length),timelineHTML(l))}

    <button class="btn btn-danger" id="deleteLeadBtn" style="margin-top:6px">Delete this lead</button>`;
  document.getElementById('detailBody').innerHTML=body;
  bindDetail(l);
}

function basicBlockHTML(l){
  const p=l.profile;
  if(!Object.keys(p).length) return `<div class="empty-note">Basic details not collected yet.</div>
    <button class="btn btn-ghost btn-sm" data-stageform="Basic Details" style="width:100%">Fill the form</button>`;
  const rows=[
    ['Employment',p.employmentType],['Age / DOB',p.ageDob],['Address',p.address],
    ['Company / business',p.employerName||p.bizName||p.blBusinessName],
    ['Monthly income',p.monthlyIncome||p.seMonthlyIncome?money(p.monthlyIncome||p.seMonthlyIncome):''],
    ['Income mode',p.incomeMode||p.seIncomeMode],['Work experience',p.workExperience||p.vintage],
    ['Required amount',p.requiredLoanAmount],['Purpose',p.purposeOfLoan],['Urgency',p.loanUrgency],
    ['CIBIL',p.cibilScore],['Existing EMI',p.totalExistingEmi?money(p.totalExistingEmi):''],
    ['Co-applicants',p.hasCoApplicants==='Yes'?(p.numCoApplicants||'Yes'):'No'],
    ['Property',p.propertyType],['Property value',p.propertyValue?money(p.propertyValue):'']
  ].filter(r=>r[1]);
  return rows.map(r=>kv(r[0],r[1])).join('')+
    `<button class="btn btn-ghost btn-sm" data-stageform="Basic Details" style="width:100%;margin-top:10px">Edit full form</button>`;
