      <select id="neReason">${['Low CIBIL score','No income proof','Income too low for this amount','FOIR crossed / too many EMIs','Property papers not clear','Area not serviceable','Negative profile for all lenders','Recent DPD or bounce','No lender funds this profile','Other'].map(r=>`<option ${n.reason===r?'selected':''}>${r}</option>`).join('')}</select></div>
    <div class="field"><label>Detail</label><textarea id="neRem" placeholder="What exactly blocked the file">${esc(n.remark||'')}</textarea></div>
    <div class="field"><label>Can we try again later?</label>
      <div class="chip-row wrap" id="neRetry">${['Yes after 6 months','Yes after 1 year','No'].map(r=>`<div class="chip ${n.retry===r?'active':''}" data-v="${esc(r)}">${esc(r)}</div>`).join('')}</div></div>
    <button class="btn btn-danger" id="saveNE">Mark not eligible</button>`;
  let retry=n.retry||'';
  body.querySelector('#neRetry').onclick=e=>{ const c=e.target.closest('.chip'); if(!c) return;
    body.querySelectorAll('#neRetry .chip').forEach(x=>x.classList.remove('active')); c.classList.add('active'); retry=c.dataset.v; };
  body.querySelector('#saveNE').onclick=()=>{
    l.notEligible={reason:body.querySelector('#neReason').value,remark:body.querySelector('#neRem').value.trim(),retry};
    logEvent(l,'Marked not eligible — '+l.notEligible.reason);
    finishStage(l,'Not Eligible','Marked not eligible');
  };
}
</script>

<script>
/* ================= QUICK ADD (Stage: New) ================= */
function openQuickAdd(){
