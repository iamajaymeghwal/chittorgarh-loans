    {key:p+'more',label:'Any other co-applicant?',type:'radio',trigger:true,options:['Yes','No'],showIf:()=>n<3}
  ],next:s=>(n<3&&s[p+'more']==='Yes')?'coapp'+(n+1):'review'};
});

function startWizard(lead){
  wizLeadId=lead?lead.id:null;
  wf=lead?Object.assign({},lead.profile):{};
  if(lead){
    wf.applicantName=wf.applicantName||lead.name; wf.mobile=wf.mobile||lead.phone;
    wf.loanTypeFinal=wf.loanTypeFinal||lead.loanType; wf.leadSource=wf.leadSource||lead.source;
    wf.employmentType=wf.employmentType||lead.customerType;
  }
  wizHistory=[]; wizScreen='basic';
  document.getElementById('wizHeaderTitle').textContent='Basic details collection';
  renderWizard(); openSheet('wizOverlay');
}
function renderWizard(){
  const body=document.getElementById('wizBody');
  if(wizScreen==='review') return renderWizReview();
  const sc=SCREENS[wizScreen];
  const visible=sc.fields.filter(f=>!f.showIf||f.showIf(wf));
  const step=wizHistory.length+1;
  body.innerHTML=`
    <div class="wiz-progress-wrap">
      <div class="wiz-progress-top"><span class="wp-title">${esc(sc.title)}</span><span>Step ${step}</span></div>
      <div class="wiz-progress-track"><div class="wiz-progress-fill" style="width:${Math.min(94,step/8*100)}%"></div></div>
    </div>
    ${visible.map(fieldHTML).join('')}
    <div class="wiz-nav-row">
      ${wizHistory.length?'<button class="btn btn-ghost" id="wizBack">Back</button>':''}
      <button class="btn btn-gold" id="wizNext">Next</button>
    </div>`;
  bindWizFields(body);
  if(wizHistory.length) body.querySelector('#wizBack').onclick=()=>{ wizScreen=wizHistory.pop(); renderWizard(); };
  body.querySelector('#wizNext').onclick=wizNext;
}
function bindWizFields(body){
  body.querySelectorAll('input[data-key],textarea[data-key]').forEach(el=>el.addEventListener('input',()=>{
    if(el.type==='tel') el.value=el.value.replace(/\D/g,'').slice(0,10);
    wf[el.dataset.key]=el.value;
  }));
  body.querySelectorAll('select[data-key]').forEach(el=>el.addEventListener('change',()=>{
    wf[el.dataset.key]=el.value; if(el.dataset.trigger) renderWizard();
  }));
  body.querySelectorAll('.field-chip-row').forEach(row=>row.addEventListener('click',e=>{
    const chip=e.target.closest('.chip'); if(!chip) return;
    const k=row.dataset.key;
    if(row.dataset.mode==='single'){
      wf[k]=chip.dataset.v;
      if(row.dataset.trigger==='1'){ renderWizard(); return; }
      row.querySelectorAll('.chip').forEach(c=>c.classList.remove('active')); chip.classList.add('active');
    } else {
      const arr=Array.isArray(wf[k])?wf[k].slice():[];
      const i=arr.indexOf(chip.dataset.v); if(i>-1) arr.splice(i,1); else arr.push(chip.dataset.v);
      wf[k]=arr; chip.classList.toggle('active');
    }
  }));
}
function wizNext(){
  const sc=SCREENS[wizScreen];
  for(const f of sc.fields){
    if(f.showIf&&!f.showIf(wf)) continue;
    if(f.required){
      const v=wf[f.key];
      const empty=f.type==='multiselect'?(!v||!v.length):(v===undefined||v===null||String(v).trim()==='');
      if(empty) return toast('Please fill: '+f.label);
    }
    if(f.type==='tel'&&wf[f.key]&&String(wf[f.key]).length!==10) return toast('Enter a valid 10-digit number');
  }
  wizHistory.push(wizScreen); wizScreen=sc.next(wf); renderWizard();
}
function renderWizReview(){
  const denied=wf.loanTypeFinal==='Customer Denied';
  const lt=denied?'Home Loan':(wf.loanTypeFinal||'Home Loan');
  const amt=parseAmountRange(wf.requiredLoanAmount);
  document.getElementById('wizBody').innerHTML=`
    <div class="wiz-progress-wrap">
      <div class="wiz-progress-top"><span class="wp-title">Review and save</span><span>Last step</span></div>
      <div class="wiz-progress-track"><div class="wiz-progress-fill" style="width:100%"></div></div>
    </div>
    ${denied?'<div class="wiz-denied-banner">Customer declined during the eligibility check. Saving will mark this lead as not eligible.</div>':''}
    <div class="review-block"><div class="rb-title">What gets saved</div>
      <div class="review-row"><span class="rk">Name</span><span class="rv">${esc(wf.applicantName||'—')}</span></div>
      <div class="review-row"><span class="rk">Mobile</span><span class="rv">${esc(wf.mobile||'—')}</span></div>
      <div class="review-row"><span class="rk">Employment</span><span class="rv">${esc(wf.employmentType||'—')}</span></div>
      <div class="review-row"><span class="rk">Loan type</span><span class="rv">${esc(wf.loanTypeFinal||'—')}</span></div>
      <div class="review-row"><span class="rk">Required</span><span class="rv">${esc(wf.requiredLoanAmount||'—')}${amt?` (${money(amt)})`:''}</span></div>
      <div class="review-row"><span class="rk">CIBIL</span><span class="rv">${esc(wf.cibilScore||'—')}</span></div>
    </div>
    <div class="field"><label>City / area</label><input type="text" id="wzCity" value="${esc(wf.city||'')}" placeholder="e.g. Nimbahera"></div>
    <div class="field"><label>Next follow-up</label><input type="date" id="wzFu" value="${esc(wf.followUpAt||'')}"></div>
    <div class="wiz-nav-row">
      <button class="btn btn-ghost" id="wizBack">Back</button>
      <button class="btn btn-gold" id="wizSave">Save details</button>
    </div>`;
  document.getElementById('wizBack').onclick=()=>{ wizScreen=wizHistory.pop(); renderWizard(); };
  document.getElementById('wizSave').onclick=()=>{
    const city=document.getElementById('wzCity').value.trim(), fu=document.getElementById('wzFu').value||null;
    let lead=wizLeadId?leadById(wizLeadId):null;
    const isNew=!lead;
    if(!lead){ lead=normalizeLead({createdAt:Date.now()}); leads.unshift(lead); }
    lead.profile=Object.assign({},wf);
    lead.name=wf.applicantName||lead.name; lead.phone=wf.mobile||lead.phone;
    lead.customerType=wf.employmentType||lead.customerType;
    lead.source=wf.leadSource||lead.source;
    if(!denied) lead.loanType=lt;
    if(amt) lead.amount=amt;
    if(city) lead.city=city;
    if(fu) lead.followUpAt=fu;
    logEvent(lead,isNew?'Lead added with full details':'Basic details collected');
    closeSheet('wizOverlay');
    if(denied){ lead.notEligible={reason:'Customer denied during eligibility check',remark:'',retry:''}; setStage(lead,'Not Eligible'); }
    else if(stageIndex(lead.stage)<stageIndex('Docs Collection')) setStage(lead,'Docs Collection');
    else commit(lead,null);
    push(isNew?'create':'update',{lead});
    toast('Details saved');
    openDetail(lead.id);
  };
}
</script>

<script>
