    .sort((a,b)=>b.disb-a.disb||b.logins-a.logins).slice(0,8);
  if(!rows.length){ document.getElementById('lenderPerf').innerHTML='<div class="empty-note">Login a file with a lender and performance shows up here.</div>'; return; }
  document.getElementById('lenderPerf').innerHTML=`<table class="mtable">
    <tr><th>Lender</th><th class="num">Login</th><th class="num">Disb</th><th class="num">Value</th></tr>
    ${rows.map(r=>`<tr><td class="tname">${esc(r.name)}</td><td class="num">${r.logins}</td><td class="num">${r.disb}</td><td class="num">${money(r.amt)}</td></tr>`).join('')}
  </table>`;
}

function renderHome(){
  renderKPI(); renderFollowStrip(); renderFunnel(); renderMoney(); renderTrend();
  renderLoanTypeBars(); renderDispoBars(); renderLenderPerf(); renderSourceBars(); renderCibilBars();
}
</script>

<script>
/* ================= LIST STATE ================= */
let fStage='all',fDispo='all',fLoan='all',fSource='all',fFollow='all',fDate='all',fFrom=null,fTo=null;
let searchQ='',sortNew=true,currentTab='home';

function activeFilterCount(){
  let n=0; [fStage,fDispo,fLoan,fSource,fFollow,fDate].forEach(v=>{ if(v!=='all') n++; });
  return n;
}
function filteredLeads(){
  let out=leads.slice();
  if(searchQ){ const q=searchQ.toLowerCase(); out=out.filter(l=>l.name.toLowerCase().includes(q)||l.phone.includes(q)); }
  if(fStage!=='all') out=out.filter(l=>l.stage===fStage);
  if(fDispo!=='all') out=out.filter(l=>l.disposition===fDispo);
  if(fLoan!=='all') out=out.filter(l=>l.loanType===fLoan);
  if(fSource!=='all') out=out.filter(l=>l.source===fSource);
  if(fFollow!=='all') out=out.filter(l=>followBucket(l)===fFollow);
  if(fDate==='week'){ const c=Date.now()-7*864e5; out=out.filter(l=>l.createdAt>=c); }
  else if(fDate==='month'){ const d=new Date(); const c=new Date(d.getFullYear(),d.getMonth(),1).getTime(); out=out.filter(l=>l.createdAt>=c); }
  else if(fDate==='custom'){
    if(fFrom) out=out.filter(l=>new Date(l.createdAt)>=new Date(fFrom));
    if(fTo) out=out.filter(l=>new Date(l.createdAt)<=new Date(fTo+'T23:59:59'));
  }
  out.sort((a,b)=>sortNew?b.createdAt-a.createdAt:a.createdAt-b.createdAt);
  return out;
}

function pipeDots(lead){
  if(lead.stage==='Not Eligible') return `<div class="pipe-dots">${FLOW_STAGES.map(()=>'<i style="background:#F2CFCB"></i>').join('')}</div>`;
  const idx=stageIndex(lead.stage);
  return `<div class="pipe-dots">${FLOW_STAGES.map((s,i)=>`<i class="${i<idx?'on':i===idx?'cur':''}"></i>`).join('')}</div>`;
}
function leadCardHTML(l){
  const b=followBucket(l);
  const fuTxt=!l.followUpAt?'No follow-up set':b==='overdue'?'Overdue · '+fmtDate(l.followUpAt):b==='today'?'Follow up today':b==='upcoming'?'Follow up '+fmtDate(l.followUpAt):'Closed file';
  const stg=STAGES.find(s=>s.k===l.stage)||STAGES[0];
  return `<div class="lead-card" data-id="${l.id}">
    <div class="lc-top">
      <div class="avatar">${esc(initials(l.name))}</div>
      <div style="flex:1;min-width:0">
        <div class="lc-name">${esc(l.name)}</div>
        <div class="lc-meta">${esc(l.phone||'No number')}${l.city?' · '+esc(l.city):''}</div>
      </div>
      <div class="lc-amt">${money(l.amount)}<small>${esc(l.loanType.replace(' (LAP)',''))}</small></div>
    </div>
    ${pipeDots(l)}
    <div class="lc-tags">
      <span class="tag" style="background:${stg.c}1A;color:${stg.c}">${esc(l.stage)}</span>
      <span class="tag" style="background:${DISPO_COLORS[l.disposition]}1A;color:${DISPO_COLORS[l.disposition]}">${esc(l.disposition)}</span>
      ${l.customerType?`<span class="tag">${esc(l.customerType)}</span>`:''}
    </div>
    <div class="lc-foot">
      <span class="fu ${b||''}">${esc(fuTxt)}</span>
      <span class="mini-acts">
        <button class="mini-btn" data-call="${esc(l.phone)}" title="Call">📞</button>
        <button class="mini-btn" data-wa="${esc(l.phone)}" title="WhatsApp">💬</button>
      </span>
    </div>
  </div>`;
}
function renderList(){
  const list=filteredLeads();
  document.getElementById('listTitle').textContent=activeFilterCount()||searchQ?`${list.length} match${list.length===1?'':'es'}`:`All leads (${list.length})`;
  document.getElementById('sortBtn').textContent=sortNew?'Newest first':'Oldest first';
  const badge=document.getElementById('filterCountBadge');
  const n=activeFilterCount();
  badge.textContent=n; badge.classList.toggle('hidden',n===0);
  document.getElementById('leadList').innerHTML=list.length?list.map(leadCardHTML).join('')
    :`<div class="card"><div class="empty-note">No leads match this view.<br>Tap + to add one.</div></div>`;
  renderFilterPills();
}
function renderFilterPills(){
  const row=document.getElementById('activeFiltersRow'); const pills=[];
  if(fStage!=='all') pills.push(['stage',fStage]);
  if(fDispo!=='all') pills.push(['dispo',fDispo]);
  if(fLoan!=='all') pills.push(['loan',fLoan]);
  if(fSource!=='all') pills.push(['source',fSource]);
  if(fFollow!=='all') pills.push(['follow',{overdue:'Overdue',today:'Due today',upcoming:'Upcoming'}[fFollow]]);
  if(fDate!=='all') pills.push(['date',fDate==='week'?'Last 7 days':fDate==='month'?'This month':`${fFrom||'…'} to ${fTo||'…'}`]);
  if(!pills.length){ row.classList.add('hidden'); row.innerHTML=''; return; }
  row.classList.remove('hidden');
  row.innerHTML=pills.map(p=>`<span class="fpill">${esc(p[1])}<span data-clearf="${p[0]}">✕</span></span>`).join('')+'<button class="clear-all-link" id="clearAllF">Clear all</button>';
}
function clearFilter(k){
  if(k==='stage')fStage='all'; if(k==='dispo')fDispo='all'; if(k==='loan')fLoan='all';
  if(k==='source')fSource='all'; if(k==='follow')fFollow='all'; if(k==='date'){fDate='all';fFrom=fTo=null;}
  renderList();
}
function clearAllFilters(){ fStage=fDispo=fLoan=fSource=fFollow=fDate='all'; fFrom=fTo=null; renderList(); }

/* ---- Filter sheet ---- */
function openFilters(){
  const chips=(arr,cur,attr)=>`<div class="chip-row wrap" data-fgroup="${attr}">
    <div class="chip ${cur==='all'?'active':''}" data-v="all">All</div>
    ${arr.map(a=>`<div class="chip ${cur===a.v?'active':''}" data-v="${esc(a.v)}">${esc(a.l)}</div>`).join('')}</div>`;
  document.getElementById('filterBody').innerHTML=`
    <div class="filter-label">Stage</div>${chips(STAGE_KEYS.map(s=>({v:s,l:s})),fStage,'stage')}
    <div class="filter-label">Disposition</div>${chips(DISPOSITIONS.map(s=>({v:s,l:s})),fDispo,'dispo')}
    <div class="filter-label">Loan type</div>${chips(LOAN_TYPES.map(s=>({v:s,l:s.replace(' (LAP)','')})),fLoan,'loan')}
    <div class="filter-label">Lead source</div>${chips(LEAD_SOURCES.map(s=>({v:s,l:s})),fSource,'source')}
    <div class="filter-label">Follow-up</div>${chips([{v:'overdue',l:'Overdue'},{v:'today',l:'Due today'},{v:'upcoming',l:'Upcoming'}],fFollow,'follow')}
    <div class="filter-label">Added</div>${chips([{v:'week',l:'Last 7 days'},{v:'month',l:'This month'},{v:'custom',l:'Custom range'}],fDate,'date')}
    <div class="field-row ${fDate==='custom'?'':'hidden'}" id="customRange" style="margin-top:10px">
      <div class="field"><label>From</label><input type="date" id="fFromI" value="${fFrom||''}"></div>
      <div class="field"><label>To</label><input type="date" id="fToI" value="${fTo||''}"></div>
    </div>
    <div class="btn-row" style="margin-top:6px">
      <button class="btn btn-ghost" id="clearFiltersBtn">Clear all</button>
      <button class="btn btn-gold" id="applyFiltersBtn">Show results</button>
    </div>`;
  const body=document.getElementById('filterBody');
  body.querySelectorAll('[data-fgroup]').forEach(g=>{
    g.addEventListener('click',e=>{
      const c=e.target.closest('.chip'); if(!c) return;
      g.querySelectorAll('.chip').forEach(x=>x.classList.remove('active')); c.classList.add('active');
      const v=c.dataset.v,k=g.dataset.fgroup;
      if(k==='stage')fStage=v; if(k==='dispo')fDispo=v; if(k==='loan')fLoan=v;
      if(k==='source')fSource=v; if(k==='follow')fFollow=v;
      if(k==='date'){ fDate=v; document.getElementById('customRange').classList.toggle('hidden',v!=='custom'); }
    });
  });
  body.querySelector('#clearFiltersBtn').onclick=()=>{ clearAllFilters(); closeSheet('filterOverlay'); };
  body.querySelector('#applyFiltersBtn').onclick=()=>{
    if(fDate==='custom'){ fFrom=document.getElementById('fFromI').value||null; fTo=document.getElementById('fToI').value||null; }
    renderList(); closeSheet('filterOverlay'); switchTab('leads');
  };
  openSheet('filterOverlay');
}

/* ================= STAGE BOARD ================= */
function renderBoard(){
  const html=STAGES.map(s=>{
    const items=leads.filter(l=>l.stage===s.k);
    const amt=items.reduce((a,l)=>a+Number(l.amount||0),0);
    return `<div class="set-item" data-stagefilter="${esc(s.k)}">
      <div class="si-l">
        <div class="set-ico" style="background:${s.c}1A;color:${s.c}">${items.length}</div>
        <div><div class="si-title">${esc(s.k)}</div><div class="si-sub">${esc(s.d)}</div></div>
      </div>
      <div style="text-align:right;flex-shrink:0"><div style="font-family:Sora;font-weight:700;font-size:13px">${money(amt)}</div></div>
    </div>`;
  }).join('');
  document.getElementById('boardList').innerHTML=html;
}

/* ================= LENDER DIRECTORY ================= */
let lenderTypeFilter='all',lenderQ='';
function renderLenderChips(){
  const types=['all',...LOAN_TYPES];
  document.getElementById('lenderTypeChips').innerHTML=types.map(t=>
    `<div class="chip ${lenderTypeFilter===t?'active':''}" data-ltype="${esc(t)}">${t==='all'?'All products':esc(t.replace(' (LAP)',''))}</div>`).join('');
}
function productCardHTML(o,opts){
