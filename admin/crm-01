function setSyncStatus(state,label){
  const d=document.getElementById('syncDot');
  d.className='sync-dot'+(state==='on'?'':state==='busy'?' busy':' off');
  document.getElementById('syncLabel').textContent=label;
}
async function sheetRequest(payload){
  if(!config.url) throw new Error('no-url');
  const res=await fetch(config.url,{method:'POST',headers:{'Content-Type':'text/plain;charset=utf-8'},body:JSON.stringify(Object.assign({key:config.key||''},payload))});
  const data=await res.json();
  if(data.error) throw new Error(data.error);
  return data;
}
async function fullSync(){
  if(!config.url){ setSyncStatus('off','Saved on this device'); document.getElementById('setupBanner').classList.remove('hidden'); return; }
  document.getElementById('setupBanner').classList.add('hidden');
  setSyncStatus('busy','Syncing');
  try{
    const data=await sheetRequest({action:'list'});
    const remote=(data.leads||[]).map(normalizeLead);
    if(!remote.length && leads.length){
      /* Sheet is empty but this phone has leads: upload instead of wiping them */
      await sheetRequest({action:'bulk',leads});
    } else { leads=remote; saveCache(); }
    if(Array.isArray(data.lenders)&&data.lenders.length){
      lenders=data.lenders; localStorage.setItem(LENDER_KEY,JSON.stringify(lenders));
    } else if(lenders.length){
      sheetRequest({action:'saveLenders',lenders}).catch(()=>{});
    }
    setSyncStatus('on','Synced with Google Sheet'); renderAll();
  }catch(e){ setSyncStatus('off','Sync failed — showing device copy'); }
}
async function push(action,payload){
  saveCache();
  if(!config.url) return;
  try{ await sheetRequest(Object.assign({action},payload)); setSyncStatus('on','Synced with Google Sheet'); }
  catch(e){ setSyncStatus('off','Saved on device — will retry'); }
}

/* ================= HELPERS ================= */
function toast(m){ const t=document.getElementById('toast'); t.textContent=m; t.classList.add('show'); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('show'),2400); }
function esc(s){ const d=document.createElement('div'); d.textContent=(s===undefined||s===null)?'':s; return d.innerHTML; }
function initials(n){ return (n||'?').trim().split(/\s+/).slice(0,2).map(w=>w[0]).join('').toUpperCase(); }
function money(n){ n=Number(n)||0; if(!n) return '—'; if(n>=1e7) return '₹'+(n/1e7).toFixed(n%1e7===0?0:2)+'Cr'; if(n>=1e5) return '₹'+(n/1e5).toFixed(n%1e5===0?0:1)+'L'; if(n>=1000) return '₹'+(n/1000).toFixed(n%1000===0?0:1)+'K'; return '₹'+n; }
function fmtDate(d){ if(!d) return '—'; const dt=new Date(d); return isNaN(dt)?'—':dt.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'2-digit'}); }
function fmtDateTime(ts){ const dt=new Date(ts); return dt.toLocaleDateString('en-IN',{day:'numeric',month:'short'})+', '+dt.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}); }
function followBucket(l){
  if(!l.followUpAt||CLOSED_DISPOSITIONS.includes(l.disposition)) return null;
  const t=todayStr();
  if(l.followUpAt<t) return 'overdue'; if(l.followUpAt===t) return 'today'; return 'upcoming';
}
function stageIndex(s){ return FLOW_STAGES.indexOf(s); }
function logEvent(lead,text){ lead.timeline.unshift({text,at:Date.now()}); if(lead.timeline.length>60) lead.timeline.length=60; }
function parseAmountRange(str){
  if(!str) return 0;
  const n=String(str).match(/[\d,]+/g); if(!n) return 0;
  const v=n.map(x=>Number(x.replace(/,/g,''))).filter(x=>x>0);
  if(!v.length) return 0;
  return Math.round(v.reduce((a,b)=>a+b,0)/v.length);
}
function pct(a,b){ return b?Math.round(a/b*100):0; }
