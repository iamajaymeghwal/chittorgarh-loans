      <div class="chip-row wrap" id="qType">${LOAN_TYPES.map((t,i)=>`<div class="chip ${i===0?'active':''}" data-v="${esc(t)}">${esc(t.replace(' (LAP)',''))}</div>`).join('')}</div></div>
