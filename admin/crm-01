  ],next:()=>'requirement'},

  vehicle:{title:'Vehicle details',fields:[
    {key:'vehicleType',label:'Vehicle type',type:'select',trigger:true,options:['Car','Tractor','Truck','JCB','Commercial vehicle','Two wheeler','Other']},
    {key:'otherVehicleType',label:'Other vehicle type',type:'text',showIf:s=>s.vehicleType==='Other'},
