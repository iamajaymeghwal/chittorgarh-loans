document.getElementById('searchInput').addEventListener('input',e=>{ searchQ=e.target.value.trim(); renderList(); });
document.getElementById('lenderSearch').addEventListener('input',e=>{ lenderQ=e.target.value.trim(); renderLenderDirectory(); });

document.getElementById('lenderTypeChips').addEventListener('click',e=>{
  const c=e.target.closest('[data-ltype]'); if(!c) return;
  lenderTypeFilter=c.dataset.ltype; renderLenderDirectory();
});
document.getElementById('lenderDirectory').addEventListener('click',e=>{
  const rm=e.target.closest('[data-callrm]'); if(rm){ const n=rm.dataset.callrm; if(n) location.href='tel:'+n; else toast('No RM number saved'); return; }
  const ed=e.target.closest('[data-editlender]'); if(ed){ openSettings(); lenderForm(lenderById(ed.dataset.editlender)); }
});

document.getElementById('leadList').addEventListener('click',e=>{
  const call=e.target.closest('[data-call]'); if(call){ e.stopPropagation(); const n=call.dataset.call; if(n) location.href='tel:'+n; else toast('No number saved'); return; }
  const wa=e.target.closest('[data-wa]'); if(wa){ e.stopPropagation(); const n=wa.dataset.wa; if(n) window.open('https://wa.me/91'+n,'_blank'); else toast('No number saved'); return; }
  const card=e.target.closest('.lead-card'); if(card) openDetail(card.dataset.id);
