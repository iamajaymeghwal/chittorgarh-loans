        <div><div class="si-title">Google Sheet sync</div><div class="si-sub">${config.url?'Connected':'Not connected'}</div></div></div>
      <span style="color:var(--muted)">›</span>
    </div>
    <div class="set-item" data-set="backup">
      <div class="si-l"><div class="set-ico" style="background:var(--purple-bg);color:var(--purple)">💾</div>
        <div><div class="si-title">Backup and restore</div><div class="si-sub">Save or load everything as one file</div></div></div>
      <span style="color:var(--muted)">›</span>
    </div>
    <div style="font-size:11px;color:var(--muted);text-align:center;margin-top:18px;line-height:1.6">Chittorgarh Loans DSA CRM<br>Leads stay on this device unless you connect a sheet.</div>`;
  document.getElementById('settingsBody').querySelectorAll('[data-set]').forEach(x=>x.onclick=()=>{
    ({lenders:lenderManager,reports:reportsPanel,sync:syncPanel,backup:backupPanel})[x.dataset.set]();
  });
