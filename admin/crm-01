}
function setBack(){ return `<button class="link-btn" id="setBackBtn" style="margin-bottom:14px">← Settings</button>`; }
function bindBack(){ const b=document.getElementById('setBackBtn'); if(b) b.onclick=openSettings; }

/* ---- Sync panel ---- */
function syncPanel(){
  document.getElementById('setTitle').textContent='Google Sheet sync';
  document.getElementById('settingsBody').innerHTML=`${setBack()}
    <div class="setup-banner"><b>How it works</b>Deploy the Apps Script web app on your Google Sheet, paste the /exec URL here, and every lead saves to the sheet as well as this phone.</div>
    <div class="field"><label>Web app URL</label><input type="text" id="cfgUrl" value="${esc(config.url)}" placeholder="https://script.google.com/macros/s/.../exec"></div>
    <div class="field"><label>Secret key (optional)</label><input type="text" id="cfgKey" value="${esc(config.key)}"></div>
    <button class="btn btn-gold" id="cfgSave">Save and sync now</button>
    <button class="btn btn-ghost" id="cfgClear" style="margin-top:10px">Disconnect sheet</button>`;
  bindBack();
  document.getElementById('cfgSave').onclick=()=>{
    config={url:document.getElementById('cfgUrl').value.trim(),key:document.getElementById('cfgKey').value.trim()};
    saveConfig(config); closeSheet('settingsOverlay'); toast('Saved — syncing'); fullSync();
  };
  document.getElementById('cfgClear').onclick=()=>{ config={url:'',key:''}; saveConfig(config); setSyncStatus('off','Saved on this device'); document.getElementById('setupBanner').classList.remove('hidden'); openSettings(); toast('Sheet disconnected'); };
}

/* ---- Backup ---- */
function backupPanel(){
  document.getElementById('setTitle').textContent='Backup and restore';
  document.getElementById('settingsBody').innerHTML=`${setBack()}
    <div class="setup-banner"><b>Keep a copy</b>The backup file holds every lead and your lender list. Save it somewhere safe once a week.</div>
    <button class="btn btn-navy" id="bkDown">Download backup file</button>
    <div class="field" style="margin-top:18px"><label>Restore from a backup file</label><input type="file" id="bkFile" accept=".json"></div>
    <button class="btn btn-ghost" id="bkRestore">Restore</button>
    <button class="btn btn-danger" id="bkReset" style="margin-top:22px">Reset lenders to the original list</button>`;
  bindBack();
  document.getElementById('bkDown').onclick=()=>saveFile('chittorgarh-crm-backup-'+todayStr()+'.json',JSON.stringify({leads,lenders,config},null,1),'application/json');
  document.getElementById('bkRestore').onclick=()=>{
    const f=document.getElementById('bkFile').files[0]; if(!f) return toast('Choose a backup file first');
    const r=new FileReader();
    r.onload=()=>{ try{
      const d=JSON.parse(r.result);
      if(Array.isArray(d.leads)) leads=d.leads.map(normalizeLead);
      if(Array.isArray(d.lenders)&&d.lenders.length) lenders=d.lenders;
      saveCache(); saveLenders(); renderAll(); closeSheet('settingsOverlay'); toast('Backup restored');
    }catch(e){ toast('That file could not be read'); } };
    r.readAsText(f);
  };
  document.getElementById('bkReset').onclick=()=>{
    if(!confirm('Replace your lender list with the original master list?')) return;
    lenders=JSON.parse(JSON.stringify(LENDER_SEED)); saveLenders(); renderAll(); toast('Lender list reset');
  };
}

/* ---- Lender manager ---- */
function lenderManager(){
  document.getElementById('setTitle').textContent='Lenders and products';
  document.getElementById('settingsBody').innerHTML=`${setBack()}
    <button class="btn btn-gold" id="addLenderBtn" style="margin-bottom:14px">Add a lender</button>
    ${lenders.map(l=>`<div class="set-item" data-lid="${esc(l.id)}">
      <div class="si-l"><div class="set-ico" style="background:var(--slate-bg);color:var(--navy)">${esc(initials(l.name))}</div>
        <div style="min-width:0"><div class="si-title">${esc(l.name)}</div>
        <div class="si-sub">${esc(l.products.map(p=>p.type.replace(' (LAP)','')).join(', ')||'No product')}${l.rm?' · '+esc(l.rm):''}</div></div></div>
      <span style="color:var(--muted)">›</span></div>`).join('')}`;
  bindBack();
  document.getElementById('addLenderBtn').onclick=()=>lenderForm(null);
  document.getElementById('settingsBody').querySelectorAll('[data-lid]').forEach(x=>x.onclick=()=>lenderForm(lenderById(x.dataset.lid)));
}
const LENDER_TEXT_FIELDS=[
  ['branch','Branch address'],['rm','RM name'],['rmContact','RM contact'],['regStatus','DSA registration status'],
  ['loginMethod','Login method'],['loginTat','Login TAT'],['serviceArea','Service area / distance rule'],
  ['target','Best fit profiles'],['negatives','Profiles to avoid'],['payoutMode','Payout mode'],
  ['payoutCycle','Payout cycle'],['clawback','Clawback rule'],['escalation','Escalation contact'],
  ['support','Support email'],['portal','Portal / app'],['offers','Running offers']
];
const PROD_TEXT_FIELDS=[
  ['name','Product name'],['range','Loan range'],['roi','Interest rate'],['tenure','Tenure'],['pf','Processing fee'],
  ['cibil','Minimum CIBIL'],['age','Age criteria'],['income','Income criteria'],['employment','Employment accepted'],
  ['experience','Experience / vintage'],['foir','FOIR'],['dpd','DPD / bounce rule'],['ltv','LTV / calculation'],
  ['payout','Our payout'],['kyc','KYC documents'],['incomeProof','Income proof'],['otherDocs','Other documents'],
  ['foreclosure','Foreclosure'],['lockin','Lock-in'],['partPay','Part payment'],['insurance','Insurance rule'],
  ['otherCharges','Other charges'],['topup','Top-up'],['rm','Product RM'],['rmContact','Product RM contact']
];
let draftLender=null;
function lenderForm(l){
  draftLender=l?JSON.parse(JSON.stringify(l)):{id:'ln'+Date.now().toString(36),name:'',products:[]};
  paintLenderForm(!!l);
}
function paintLenderForm(isEdit){
  document.getElementById('setTitle').textContent=isEdit?'Edit lender':'Add lender';
  const d=draftLender;
  document.getElementById('settingsBody').innerHTML=`
    <button class="link-btn" id="lfBack" style="margin-bottom:14px">← Lenders</button>
    <div class="field"><label>Lender name <span class="req">*</span></label><input type="text" data-lf="name" value="${esc(d.name)}"></div>
    ${LENDER_TEXT_FIELDS.map(f=>`<div class="field"><label>${esc(f[1])}</label><input type="text" data-lf="${f[0]}" value="${esc(d[f[0]]||'')}"></div>`).join('')}
    <div class="sec-head" style="margin-top:20px"><h2>Products</h2><button class="link-btn" id="lfAddProd">Add product</button></div>
    ${d.products.map((p,i)=>`<div class="prod-edit">
      <div class="prod-edit-head"><b>Product ${i+1}</b><button class="link-btn" style="color:var(--danger)" data-rmprod="${i}">Remove</button></div>
      <div class="field"><label>Loan type</label><select data-pf="type" data-pi="${i}">${LOAN_TYPES.map(t=>`<option ${p.type===t?'selected':''}>${esc(t)}</option>`).join('')}</select></div>
      ${PROD_TEXT_FIELDS.map(f=>`<div class="field"><label>${esc(f[1])}</label><input type="text" data-pf="${f[0]}" data-pi="${i}" value="${esc(p[f[0]]||'')}"></div>`).join('')}
    </div>`).join('')}
    <button class="btn btn-gold" id="lfSave" style="margin-top:8px">Save lender</button>
    ${isEdit?'<button class="btn btn-danger" id="lfDelete" style="margin-top:10px">Delete this lender</button>':''}`;
  const b=document.getElementById('settingsBody');
  b.querySelector('#lfBack').onclick=lenderManager;
  b.querySelectorAll('[data-lf]').forEach(el=>el.addEventListener('input',()=>{ d[el.dataset.lf]=el.value; }));
  b.querySelectorAll('[data-pf]').forEach(el=>el.addEventListener('input',()=>{ d.products[el.dataset.pi][el.dataset.pf]=el.value; }));
  b.querySelectorAll('select[data-pf]').forEach(el=>el.addEventListener('change',()=>{ d.products[el.dataset.pi][el.dataset.pf]=el.value; }));
  b.querySelector('#lfAddProd').onclick=()=>{ d.products.push({type:LOAN_TYPES[0],name:''}); paintLenderForm(isEdit); };
  b.querySelectorAll('[data-rmprod]').forEach(x=>x.onclick=()=>{ d.products.splice(Number(x.dataset.rmprod),1); paintLenderForm(isEdit); });
  b.querySelector('#lfSave').onclick=()=>{
    if(!d.name.trim()) return toast('Enter the lender name');
    const i=lenders.findIndex(x=>x.id===d.id);
    if(i>-1) lenders[i]=d; else lenders.push(d);
    saveLenders(); renderAll(); lenderManager(); toast('Lender saved');
  };
  const del=b.querySelector('#lfDelete');
  if(del) del.onclick=()=>{ if(!confirm('Delete '+d.name+'?')) return; lenders=lenders.filter(x=>x.id!==d.id); saveLenders(); renderAll(); lenderManager(); toast('Lender deleted'); };
}

/* ================= REPORTS ================= */
let repFrom='',repTo='';
function reportsPanel(){
  document.getElementById('setTitle').textContent='Reports and downloads';
  const reports=[
    ['leads','All leads','Every field, one row per lead'],
    ['pipeline','Pipeline by stage','Count and value at each stage'],
    ['followup','Follow-up list','Overdue, today and upcoming'],
    ['lender','Lender performance','Logins, sanctions, disbursals per lender'],
    ['commission','Commission register','Payout received and pending'],
    ['docs','Document status','What is still pending per lead'],
    ['noteligible','Not eligible reasons','Why files were dropped'],
    ['master','Lender master','Your full lender and product list']
  ];
  document.getElementById('settingsBody').innerHTML=`${setBack()}
    <div class="field-row">
      <div class="field"><label>From date</label><input type="date" id="repFrom" value="${repFrom}"></div>
      <div class="field"><label>To date</label><input type="date" id="repTo" value="${repTo}"></div>
    </div>
    <div style="font-size:11.5px;color:var(--muted);margin-bottom:14px">Leave dates empty to include everything. Files download as CSV and open in Excel or Google Sheets.</div>
    ${reports.map(r=>`<div class="set-item" data-rep="${r[0]}">
      <div class="si-l"><div class="set-ico" style="background:var(--success-bg);color:var(--green)">⬇</div>
        <div><div class="si-title">${esc(r[1])}</div><div class="si-sub">${esc(r[2])}</div></div></div>
      <span style="color:var(--muted)">CSV</span></div>`).join('')}`;
  bindBack();
  const b=document.getElementById('settingsBody');
  b.querySelector('#repFrom').onchange=e=>repFrom=e.target.value;
  b.querySelector('#repTo').onchange=e=>repTo=e.target.value;
  b.querySelectorAll('[data-rep]').forEach(x=>x.onclick=()=>buildReport(x.dataset.rep));
}
function repLeads(){
  let out=leads.slice();
  if(repFrom) out=out.filter(l=>new Date(l.createdAt)>=new Date(repFrom));
  if(repTo) out=out.filter(l=>new Date(l.createdAt)<=new Date(repTo+'T23:59:59'));
  return out;
}
function csvCell(v){ const s=(v===undefined||v===null)?'':String(v); return /[",\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s; }
function toCSV(rows){ return rows.map(r=>r.map(csvCell).join(',')).join('\n'); }
function lenderNameOf(key){ const o=key&&productByKey(key); return o?o.lender.name:''; }
function buildReport(kind){
  const L=repLeads(); let rows=[],fname='report';
  if(kind==='leads'){
    fname='all-leads';
    rows=[['Name','Mobile','Loan type','Amount','Customer type','City','Stage','Disposition','Source','Follow-up','Added on',
      'Employment','Monthly income','CIBIL','Existing EMI','Required amount','Purpose','Urgency','Docs done','Docs total',
      'Suggested lenders','Eligible lenders','Logins','Sanction lender','Sanction amount','Disbursed amount','Disbursed on','Commission','Not eligible reason']];
    L.forEach(l=>{
      const g=docChecklistFor(l), all=g.reduce((a,x)=>a.concat(x.items),[]);
      const p=l.profile||{};
      rows.push([l.name,l.phone,l.loanType,l.amount,l.customerType,l.city,l.stage,l.disposition,l.source,l.followUpAt||'',fmtDate(l.createdAt),
        p.employmentType||'',p.monthlyIncome||p.seMonthlyIncome||'',p.cibilScore||'',p.totalExistingEmi||'',p.requiredLoanAmount||'',p.purposeOfLoan||'',p.loanUrgency||'',
        all.filter(d=>l.docs[d]).length,all.length,
        l.suggested.map(lenderNameOf).join(' | '),l.eligible.map(lenderNameOf).join(' | '),
        l.logins.map(x=>lenderNameOf(x.key)+' '+(x.status||'')).join(' | '),
        l.sanction?lenderNameOf(l.sanction.key):'',l.sanction?l.sanction.amount:'',
        l.disbursal?l.disbursal.amount:'',l.disbursal?l.disbursal.date:'',
        l.commission?l.commission.amount:'',l.notEligible?l.notEligible.reason:'']);
    });
  } else if(kind==='pipeline'){
    fname='pipeline-by-stage';
    rows=[['Stage','Leads','Total requested','Share %']];
    STAGE_KEYS.forEach(s=>{ const ls=L.filter(l=>l.stage===s);
      rows.push([s,ls.length,ls.reduce((a,l)=>a+Number(l.amount||0),0),pct(ls.length,L.length)]); });
    rows.push(['Total',L.length,L.reduce((a,l)=>a+Number(l.amount||0),0),100]);
  } else if(kind==='followup'){
    fname='follow-up-list';
    rows=[['Bucket','Name','Mobile','Loan type','Amount','Stage','Disposition','Follow-up date','Last note']];
    L.filter(l=>followBucket(l)).sort((a,b)=>(a.followUpAt>b.followUpAt?1:-1)).forEach(l=>
      rows.push([followBucket(l),l.name,l.phone,l.loanType,l.amount,l.stage,l.disposition,l.followUpAt,(l.timeline[0]||{}).text||'']));
  } else if(kind==='lender'){
    fname='lender-performance';
    const map={};
    const touch=id=>{ if(!map[id]) map[id]={logins:0,sanc:0,sancAmt:0,disb:0,disbAmt:0,comm:0}; return map[id]; };
    L.forEach(l=>{
      (l.logins||[]).forEach(g=>{ const o=productByKey(g.key); if(o) touch(o.lender.id).logins++; });
      if(l.sanction&&l.sanction.key){ const o=productByKey(l.sanction.key); if(o){ const r=touch(o.lender.id); r.sanc++; r.sancAmt+=Number(l.sanction.amount||0); } }
      if(l.disbursal&&l.disbursal.amount){ const k=(l.sanction&&l.sanction.key)||((l.logins[0]||{}).key); const o=k&&productByKey(k);
        if(o){ const r=touch(o.lender.id); r.disb++; r.disbAmt+=Number(l.disbursal.amount||0); r.comm+=Number((l.commission||{}).amount||0); } }
    });
    rows=[['Lender','RM','RM contact','Logins','Sanctioned','Sanctioned value','Disbursed','Disbursed value','Commission','Conversion %']];
    Object.keys(map).forEach(id=>{ const l=lenderById(id)||{}; const r=map[id];
      rows.push([l.name||id,l.rm||'',l.rmContact||'',r.logins,r.sanc,r.sancAmt,r.disb,r.disbAmt,r.comm,pct(r.disb,r.logins)]); });
    if(rows.length===1) rows.push(['No login recorded yet']);
  } else if(kind==='commission'){
    fname='commission-register';
    rows=[['Name','Mobile','Lender','Disbursed amount','Disbursed on','Payout %','Commission amount','Received on','Mode','Status','Remark']];
    L.filter(l=>l.disbursal||l.commission).forEach(l=>{
      const k=(l.sanction&&l.sanction.key)||((l.logins[0]||{}).key); const c=l.commission||{};
      rows.push([l.name,l.phone,lenderNameOf(k),(l.disbursal||{}).amount||'',(l.disbursal||{}).date||'',
        c.percent||'',c.amount||'',c.receivedOn||'',c.mode||'',c.amount?'Received':'Pending',c.remark||'']);
    });
    const got=L.reduce((a,l)=>a+Number((l.commission||{}).amount||0),0);
    rows.push([]); rows.push(['Total commission received','','','','','',got]);
  } else if(kind==='docs'){
    fname='document-status';
    rows=[['Name','Mobile','Loan type','Customer type','Stage','Collected','Total','Pending documents']];
    L.forEach(l=>{ const g=docChecklistFor(l), all=g.reduce((a,x)=>a.concat(x.items),[]);
      const pend=all.filter(d=>!l.docs[d]);
      rows.push([l.name,l.phone,l.loanType,l.customerType,l.stage,all.length-pend.length,all.length,pend.join(' | ')]); });
  } else if(kind==='noteligible'){
    fname='not-eligible';
    rows=[['Name','Mobile','Loan type','Amount','Reason','Detail','Retry','Marked on']];
    L.filter(l=>l.stage==='Not Eligible'||l.disposition==='Not Eligible').forEach(l=>{
      const n=l.notEligible||{}; rows.push([l.name,l.phone,l.loanType,l.amount,n.reason||'',n.remark||'',n.retry||'',fmtDate(l.createdAt)]); });
  } else if(kind==='master'){
    fname='lender-master';
    rows=[['Lender','Product type','Product','Loan range','Interest','Tenure','Processing fee','Min CIBIL','Age','Income','FOIR','DPD rule','Our payout','Payout cycle','Clawback','Login TAT','Service area','Avoid profiles','RM','RM contact','Branch']];
    lenders.forEach(l=>{
      if(!l.products.length) rows.push([l.name,'','','','','','','','','','','','',l.payoutCycle||'',l.clawback||'',l.loginTat||'',l.serviceArea||'',l.negatives||'',l.rm||'',l.rmContact||'',l.branch||'']);
      l.products.forEach(p=>rows.push([l.name,p.type,p.name||'',p.range||'',p.roi||'',p.tenure||'',p.pf||'',p.cibil||'',p.age||'',p.income||'',p.foir||'',p.dpd||'',p.payout||'',l.payoutCycle||'',l.clawback||'',l.loginTat||'',l.serviceArea||'',l.negatives||'',p.rm||l.rm||'',p.rmContact||l.rmContact||'',l.branch||'']));
    });
  }
  const suffix=(repFrom||repTo)?`-${repFrom||'start'}_${repTo||'today'}`:'';
  saveFile(`${fname}${suffix}.csv`,'\ufeff'+toCSV(rows),'text/csv;charset=utf-8;');
}
function saveFile(name,text,mime){
  try{
    const blob=new Blob([text],{type:mime});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a'); a.href=url; a.download=name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),4000);
    toast('Downloaded '+name);
  }catch(e){ showTextFallback(name,text); }
}
function showTextFallback(name,text){
  document.getElementById('setTitle').textContent=name;
  document.getElementById('settingsBody').innerHTML=`${setBack()}
    <div style="font-size:12px;color:var(--muted);margin-bottom:10px">Download is blocked here. Copy this and paste it into a sheet.</div>
    <textarea id="fallbackTxt" style="width:100%;min-height:260px;font-size:11px">${esc(text)}</textarea>
    <button class="btn btn-gold" id="copyTxt" style="margin-top:10px">Copy all</button>`;
  bindBack();
  document.getElementById('copyTxt').onclick=()=>{ const t=document.getElementById('fallbackTxt'); t.select(); document.execCommand('copy'); toast('Copied'); };
}

/* ================= SHEETS / TABS / EVENTS ================= */
function openSheet(id){ document.getElementById(id).classList.add('show'); }
function closeSheet(id){ document.getElementById(id).classList.remove('show'); }
function switchTab(tab){
  currentTab=tab;
  ['home','leads','board','lenders'].forEach(t=>document.getElementById(t+'View').classList.toggle('hidden',t!==tab));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.toggle('active',n.dataset.tab===tab));
  document.getElementById('mainScroll').scrollTop=0;
  if(tab==='home') renderHome(); if(tab==='leads') renderList(); if(tab==='board') renderBoard(); if(tab==='lenders') renderLenderDirectory();
}
function renderAll(){ renderTopStats(); renderHome(); renderList(); renderBoard(); renderLenderDirectory(); }

document.querySelectorAll('.nav-item').forEach(n=>n.onclick=()=>switchTab(n.dataset.tab));
document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>closeSheet(b.dataset.close));
