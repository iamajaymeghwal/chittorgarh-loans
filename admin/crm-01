[1,2,3].forEach(n=>{
  const p='co'+n+'_';
  SCREENS['coapp'+n]={title:'Co-applicant '+n,fields:[
    {key:p+'name',label:'Full name',type:'text',required:n===1},
    {key:p+'mobile',label:'Mobile number',type:'tel',required:n===1},
    {key:p+'relation',label:'Relation with applicant',type:'text'},
    {key:p+'age',label:'Age',type:'text'},
    {key:p+'occupation',label:'Company / business / occupation',type:'text'},
    {key:p+'income',label:'Monthly income (₹)',type:'number'},
