let wf={},wizHistory=[],wizScreen='basic',wizLeadId=null;
function fval(f){ return wf[f.key]!==undefined?wf[f.key]:(f.type==='multiselect'?[]:''); }
function fieldHTML(f){
  const v=fval(f), req=f.required?' <span class="req">*</span>':'';
  let inner='';
  const opts=typeof f.options==='function'?f.options(wf):f.options;
  if(['text','tel','number','date'].includes(f.type)){
    inner=`<input type="${f.type}" data-key="${f.key}" placeholder="${esc(f.placeholder||'')}" value="${esc(v)}" ${f.type==='tel'?'maxlength="10" inputmode="numeric"':''}>`;
  } else if(f.type==='textarea'){ inner=`<textarea data-key="${f.key}" placeholder="${esc(f.placeholder||'')}">${esc(v)}</textarea>`; }
  else if(f.type==='select'){
    inner=`<select data-key="${f.key}" ${f.trigger?'data-trigger="1"':''}><option value="">${esc(f.placeholder||'Select')}</option>
      ${opts.map(o=>`<option ${o===v?'selected':''}>${esc(o)}</option>`).join('')}</select>`;
  } else if(f.type==='radio'){
    inner=`<div class="chip-row wrap field-chip-row" data-key="${f.key}" data-mode="single" ${f.trigger?'data-trigger="1"':''}>
      ${opts.map(o=>`<div class="chip ${o===v?'active':''}" data-v="${esc(o)}">${esc(o)}</div>`).join('')}</div>`;
  } else if(f.type==='multiselect'){
    const arr=Array.isArray(v)?v:[];
    inner=`<div class="chip-row wrap field-chip-row" data-key="${f.key}" data-mode="multi">
      ${opts.map(o=>`<div class="chip ${arr.includes(o)?'active':''}" data-v="${esc(o)}">${esc(o)}</div>`).join('')}</div>`;
  }
  return `<div class="field">${f.label?`<label>${esc(f.label)}${req}</label>`:''}${inner}${f.hint?`<div class="hint">${esc(f.hint)}</div>`:''}</div>`;
}
const LT_OPTS=[...LOAN_TYPES,'Customer Denied'];
