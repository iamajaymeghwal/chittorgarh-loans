document.getElementById('detailBody').addEventListener('click',e=>{
  const call=e.target.closest('[data-call]'); if(call){ const n=call.dataset.call; if(n) location.href='tel:'+n; return; }
  const wa=e.target.closest('[data-wa]'); if(wa){ const n=wa.dataset.wa; if(n) window.open('https://wa.me/91'+n,'_blank'); }
});
document.getElementById('homeView').addEventListener('click',e=>{
  const s=e.target.closest('[data-stagefilter]');
  if(s){ clearAllFilters(); fStage=s.dataset.stagefilter; switchTab('leads'); renderList(); return; }
  const f=e.target.closest('[data-follow]');
  if(f){ clearAllFilters(); fFollow=f.dataset.follow; switchTab('leads'); renderList(); return; }
  const b=e.target.closest('[data-barfilter]');
  if(b){ const flt=JSON.parse(b.dataset.barfilter); clearAllFilters();
    if(flt.loanType) fLoan=flt.loanType; if(flt.disposition) fDispo=flt.disposition; if(flt.source) fSource=flt.source;
    switchTab('leads'); renderList(); }
});
document.getElementById('boardList').addEventListener('click',e=>{
  const s=e.target.closest('[data-stagefilter]');
  if(s){ clearAllFilters(); fStage=s.dataset.stagefilter; switchTab('leads'); renderList(); }
});
document.getElementById('activeFiltersRow').addEventListener('click',e=>{
  const c=e.target.closest('[data-clearf]'); if(c) return clearFilter(c.dataset.clearf);
  if(e.target.id==='clearAllF') clearAllFilters();
});

/* ================= BOOT ================= */
renderAll();
fullSync();
</script>
</body>
</html>
