function bindDetail(l){
  const b=document.getElementById('detailBody');
  b.querySelectorAll('[data-blk]').forEach(h=>h.onclick=()=>{ const k=h.dataset.blk; openBlocks[k]=!openBlocks[k]; renderDetail(); });
  b.querySelectorAll('[data-stageform]').forEach(x=>x.onclick=()=>openStageForm(l,x.dataset.stageform));
  const de=b.querySelector('#dispoPick');
  if(de) de.onclick=e=>{ const c=e.target.closest('[data-dispo]'); if(!c) return; setDisposition(l,c.dataset.dispo); };
  const fu=b.querySelector('#fuDate');
  if(fu) fu.onchange=()=>{ l.followUpAt=fu.value||null; logEvent(l,'Follow-up set for '+fmtDate(fu.value)); commit(l,'Follow-up saved'); };
  const sp=b.querySelector('#stagePick');
  if(sp) sp.onchange=()=>{ setStage(l,sp.value,true); };
  const nb=b.querySelector('#addNoteBtn');
  if(nb) nb.onclick=()=>{ const t=b.querySelector('#noteBox').value.trim(); if(!t) return toast('Write something first'); logEvent(l,t); commit(l,'Note saved'); };
  const dl=b.querySelector('#deleteLeadBtn');
  if(dl) dl.onclick=()=>{ if(!confirm('Delete '+l.name+' permanently?')) return; leads=leads.filter(x=>x.id!==l.id); push('delete',{id:l.id}); closeSheet('detailOverlay'); renderAll(); toast('Lead deleted'); };
  const el=b.querySelector('[data-editlead]');
  if(el) el.onclick=()=>openEdit(l);
  const ro=b.querySelector('[data-reopen]');
  if(ro) ro.onclick=()=>{ l.stage='Basic Details'; l.disposition='Follow Up'; logEvent(l,'Lead reopened'); commit(l,'Lead reopened'); };
}

function commit(l,msg){
  saveCache(); push('update',{lead:l});
  renderAll(); if(openLeadId===l.id) renderDetail();
  if(msg) toast(msg);
}
function setDisposition(l,d){
  l.disposition=d; logEvent(l,'Disposition set to '+d);
  if(d==='Not Eligible'&&l.stage!=='Not Eligible') l.stage='Not Eligible';
  if(d==='Closed'&&l.stage!=='Closed') l.stage='Closed';
  commit(l,'Disposition updated');
}
function setStage(l,stage,silent){
  if(l.stage===stage) return;
  l.stage=stage; logEvent(l,'Moved to '+stage);
  if(stage==='Disbursed') l.disposition='Disbursed';
  else if(stage==='Closed') l.disposition='Closed';
  else if(stage==='Not Eligible') l.disposition='Not Eligible';
  else if(l.disposition==='Not Connected'&&stage!=='New') l.disposition='Interested';
  commit(l,silent?'Stage updated':null);
}

/* ================= STAGE FORMS ================= */
function openStageForm(l,stage){
  if(!stage) return;
  if(stage==='Basic Details'){ startWizard(l); return; }
  document.getElementById('stageTitle').textContent=stage;
  const body=document.getElementById('stageBody');
  const render={
    'Docs Collection':docsForm,'Lenders Suggestion':suggestForm,'Eligible Lenders':eligibleForm,
    'Logined':loginForm,'Sanctioned':sanctionForm,'Commission Got':commissionForm,
    'Disbursed':disbursalForm,'Closed':closeForm,'Not Eligible':notEligibleForm
  }[stage];
  if(!render){ setStage(l,stage); return; }
  render(l,body);
  openSheet('stageOverlay');
}
function finishStage(l,stage,msg){
  const cur=stageIndex(l.stage), tgt=stageIndex(stage);
  if(tgt>cur||TERMINAL_STAGES.includes(stage)) setStage(l,stage);
  else commit(l,null);
  closeSheet('stageOverlay'); toast(msg||'Saved');
}

