  if(lenderTypeFilter!=='all') list=list.filter(o=>o.product.type===lenderTypeFilter);
  if(lenderQ){ const q=lenderQ.toLowerCase(); list=list.filter(o=>o.lender.name.toLowerCase().includes(q)||(o.lender.rm||'').toLowerCase().includes(q)||(o.product.rm||'').toLowerCase().includes(q)); }
