      ${p.kyc||p.incomeProof||p.otherDocs?`<div><b>Docs:</b> ${esc([p.kyc,p.incomeProof,p.otherDocs].filter(Boolean).join(' | '))}</div>`:''}
      ${p.foreclosure?`<div><b>Foreclosure:</b> ${esc(p.foreclosure)}</div>`:''}
