<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Chittorgarh Loans — DSA CRM</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#0A2540; --navy-2:#123A63; --blue:#1B6FC9; --blue-dark:#12508F;
  --gold:#C9A227; --gold-dark:#A8841C; --green:#0F8B5F; --green-dark:#0B6E4A;
  --cream:#F4F7FA; --card:#FFFFFF; --ink:#12202E; --muted:#66798D; --border:#E1E7EE;
  --success:#0F8B5F; --success-bg:#E3F5EC; --danger:#C0463C; --danger-bg:#FBEAE8;
  --warn:#D98A2B; --warn-bg:#FBF0DF; --info:#1B6FC9; --info-bg:#E7F0FB;
  --purple:#6D4FC6; --purple-bg:#EEEAF9; --pink:#C13F84; --pink-bg:#FBEAF3;
  --maroon:#8C2F2F; --maroon-bg:#F5E2E0; --slate:#5B6472; --slate-bg:#EAECEF;
  --teal:#0E7C86; --teal-bg:#E2F2F3;
  --radius:16px;
  --shadow:0 2px 10px rgba(10,37,64,.07),0 1px 2px rgba(10,37,64,.06);
  --pad-top:env(safe-area-inset-top,0px);
  --pad-bot:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;}
html{scroll-padding-top:var(--pad-top);}
body{font-family:'Inter',system-ui,sans-serif;background:var(--cream);color:var(--ink);min-height:100vh;display:flex;justify-content:center;}
h1,h2,h3,.font-display{font-family:'Sora',system-ui,sans-serif;}
button,input,select,textarea{font-family:inherit;}
::-webkit-scrollbar{width:0;height:0;}
.hidden{display:none !important;}
:focus-visible{outline:2px solid var(--gold);outline-offset:2px;}
@media (prefers-reduced-motion:reduce){*{animation:none !important;transition:none !important;}}

.app{width:100%;max-width:480px;min-height:100vh;background:var(--cream);position:relative;display:flex;flex-direction:column;box-shadow:0 0 40px rgba(0,0,0,.06);}

/* ---------- TOPBAR ---------- */
.topbar{background:linear-gradient(135deg,var(--navy) 0%,var(--navy-2) 60%,var(--blue-dark) 100%);color:#fff;padding:calc(16px + var(--pad-top)) 16px 20px;border-radius:0 0 22px 22px;position:relative;overflow:hidden;}
.topbar::after{content:"";position:absolute;right:-40px;top:-40px;width:170px;height:170px;border-radius:50%;background:radial-gradient(circle,rgba(201,162,39,.26) 0%,rgba(201,162,39,0) 70%);}
.topbar-row{display:flex;align-items:center;justify-content:space-between;position:relative;z-index:1;gap:8px;}
.brand{display:flex;align-items:center;gap:10px;min-width:0;}
.brand-mark{width:38px;height:38px;border-radius:10px;background:linear-gradient(135deg,var(--gold),var(--gold-dark));display:flex;align-items:center;justify-content:center;font-family:'Sora';font-weight:800;color:var(--navy);font-size:15px;flex-shrink:0;}
.brand-text .name{font-family:'Sora';font-weight:700;font-size:15px;line-height:1.2;}
.brand-text .sub{font-size:11px;color:rgba(255,255,255,.7);margin-top:2px;display:flex;align-items:center;gap:5px;}
.sync-dot{width:6px;height:6px;border-radius:50%;background:#63D68A;flex-shrink:0;}
.sync-dot.off{background:#E86A5C;} .sync-dot.busy{background:var(--gold);animation:pulse 1s infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.icon-btn{width:38px;height:38px;border-radius:10px;background:rgba(255,255,255,.1);border:none;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;}
.topbar-stats{display:flex;gap:8px;margin-top:16px;position:relative;z-index:1;}
.tstat{flex:1;background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.15);border-radius:12px;padding:10px;}
.tstat .num{font-family:'Sora';font-weight:700;font-size:19px;line-height:1.1;}
.tstat .lbl{font-size:10.5px;color:rgba(255,255,255,.7);margin-top:3px;}

.main{flex:1;overflow-y:auto;padding:16px 16px calc(96px + var(--pad-bot));}

/* ---------- SECTION / CARD ---------- */
.sec{margin-bottom:18px;}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;margin:0 2px 9px;gap:8px;}
.sec-head h2{font-size:14.5px;font-weight:700;margin:0;letter-spacing:-.01em;}
.sec-head .note{font-size:11.5px;color:var(--muted);}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow);padding:14px;}
.card+.card{margin-top:10px;}

/* ---------- KPI ---------- */
.kpi-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.kpi{background:var(--card);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:12px 13px;position:relative;overflow:hidden;}
.kpi::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--accent,var(--blue));}
.kpi .k-lbl{font-size:11px;color:var(--muted);font-weight:500;}
.kpi .k-num{font-family:'Sora';font-weight:700;font-size:22px;margin-top:4px;letter-spacing:-.02em;line-height:1.15;}
.kpi .k-sub{font-size:10.5px;color:var(--muted);margin-top:3px;}
.kpi .k-sub strong{color:var(--ink);font-weight:600;}

/* ---------- BARS ---------- */
.bar{margin-bottom:12px;}
.bar:last-child{margin-bottom:0;}
.bar-top{display:flex;align-items:baseline;justify-content:space-between;gap:8px;margin-bottom:5px;}
.bar-name{font-size:12.5px;font-weight:600;color:var(--ink);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.bar-val{font-size:12px;font-weight:700;font-family:'Sora';flex-shrink:0;}
.bar-val em{font-style:normal;color:var(--muted);font-weight:500;font-size:11px;margin-left:5px;font-family:'Inter';}
.bar-track{height:9px;border-radius:6px;background:#EEF2F6;overflow:hidden;}
.bar-fill{height:100%;border-radius:6px;transition:width .35s ease;min-width:3px;}
.bar.clickable{cursor:pointer;}
.bar-sub{font-size:10.5px;color:var(--muted);margin-top:4px;}
.empty-note{font-size:12.5px;color:var(--muted);text-align:center;padding:14px 0;}

/* ---------- FUNNEL ---------- */
.funnel-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px dashed var(--border);cursor:pointer;}
.funnel-row:last-child{border-bottom:none;}
.fn-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.fn-name{font-size:12.5px;font-weight:600;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.fn-bar{width:78px;height:7px;border-radius:5px;background:#EEF2F6;overflow:hidden;flex-shrink:0;}
.fn-bar i{display:block;height:100%;border-radius:5px;}
.fn-count{font-family:'Sora';font-weight:700;font-size:13px;width:30px;text-align:right;flex-shrink:0;}

/* ---------- COLUMN CHART ---------- */
.colchart{display:flex;align-items:flex-end;gap:6px;height:118px;padding-top:6px;}
.colwrap{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;height:100%;justify-content:flex-end;}
.colnum{font-size:10.5px;font-weight:700;font-family:'Sora';color:var(--navy);}
.colbar{width:100%;background:linear-gradient(180deg,var(--blue),var(--navy-2));border-radius:5px 5px 2px 2px;min-height:3px;transition:height .35s ease;}
.collbl{font-size:9.5px;color:var(--muted);white-space:nowrap;}

/* ---------- MINI TABLE ---------- */
.mtable{width:100%;border-collapse:collapse;font-size:12px;}
.mtable th{text-align:left;font-size:10.5px;color:var(--muted);font-weight:600;padding:0 0 7px;border-bottom:1px solid var(--border);}
.mtable td{padding:8px 0;border-bottom:1px solid #F1F4F8;}
.mtable tr:last-child td{border-bottom:none;}
.mtable td.num,.mtable th.num{text-align:right;font-family:'Sora';font-weight:600;}
.mtable .tname{font-weight:600;}

/* ---------- PILL STRIP ---------- */
.strip{display:flex;gap:8px;}
.strip-item{flex:1;border-radius:13px;padding:11px 10px;text-align:center;cursor:pointer;border:1px solid transparent;}
.strip-item .n{font-family:'Sora';font-weight:700;font-size:20px;line-height:1;}
.strip-item .l{font-size:10.5px;margin-top:5px;font-weight:500;}

/* ---------- LEAD CARD ---------- */
.lead-card{background:var(--card);border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow);padding:12px;margin-bottom:10px;cursor:pointer;}
.lc-top{display:flex;gap:10px;align-items:flex-start;}
.avatar{width:38px;height:38px;border-radius:11px;background:var(--info-bg);color:var(--blue-dark);display:flex;align-items:center;justify-content:center;font-family:'Sora';font-weight:700;font-size:13px;flex-shrink:0;}
.lc-name{font-weight:700;font-size:14px;line-height:1.25;}
.lc-meta{font-size:11.5px;color:var(--muted);margin-top:2px;}
.lc-amt{font-family:'Sora';font-weight:700;font-size:14px;text-align:right;flex-shrink:0;}
.lc-amt small{display:block;font-size:10px;color:var(--muted);font-weight:500;font-family:'Inter';margin-top:2px;}
.lc-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px;}
.tag{font-size:10.5px;font-weight:600;padding:3.5px 8px;border-radius:7px;background:var(--slate-bg);color:var(--slate);}
.lc-foot{display:flex;align-items:center;justify-content:space-between;margin-top:10px;padding-top:9px;border-top:1px solid #F1F4F8;gap:8px;}
.fu{font-size:11px;font-weight:600;}
.fu.overdue{color:var(--danger);} .fu.today{color:var(--warn);} .fu.upcoming{color:var(--muted);}
.mini-acts{display:flex;gap:6px;}
.mini-btn{width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;}
.pipe-dots{display:flex;gap:3px;margin-top:9px;}
.pipe-dots i{height:4px;flex:1;border-radius:3px;background:#E6EBF1;}
.pipe-dots i.on{background:var(--green);}
.pipe-dots i.cur{background:var(--gold);}

/* ---------- FORM ---------- */
.field{margin-bottom:13px;}
.field label{display:block;font-size:12px;font-weight:600;margin-bottom:6px;color:var(--ink);}
.field .req{color:var(--danger);}
.field input,.field select,.field textarea{width:100%;padding:11px 12px;border:1px solid var(--border);border-radius:11px;font-size:14px;background:#fff;color:var(--ink);}
.field textarea{min-height:76px;resize:vertical;}
.field .hint{font-size:11px;color:var(--muted);margin-top:5px;}
.field-row{display:flex;gap:10px;}
.field-row .field{flex:1;}
.chip-row{display:flex;gap:7px;overflow-x:auto;}
.chip-row.wrap{flex-wrap:wrap;overflow:visible;}
.chip{padding:7px 12px;border-radius:9px;border:1px solid var(--border);background:#fff;font-size:12.5px;font-weight:500;cursor:pointer;white-space:nowrap;color:var(--slate);}
.chip.active{background:var(--navy);border-color:var(--navy);color:#fff;font-weight:600;}
.btn{width:100%;padding:13px;border-radius:12px;border:none;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;}
.btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--navy);}
.btn-navy{background:var(--navy);color:#fff;}
.btn-green{background:var(--green);color:#fff;}
.btn-ghost{background:#fff;border:1px solid var(--border);color:var(--ink);}
.btn-danger{background:var(--danger-bg);color:var(--danger);border:1px solid #F2CFCB;}
.btn-sm{padding:9px 12px;font-size:12.5px;width:auto;}
.btn-row{display:flex;gap:9px;}
.btn-row .btn{flex:1;}
.link-btn{background:none;border:none;color:var(--blue);font-size:12px;font-weight:600;cursor:pointer;padding:0;}

/* ---------- OVERLAY / SHEET ---------- */
.overlay{position:fixed;inset:0;background:rgba(10,37,64,.45);z-index:60;display:none;align-items:flex-end;justify-content:center;}
.overlay.show{display:flex;}
.sheet{width:100%;max-width:480px;background:var(--cream);border-radius:22px 22px 0 0;max-height:94vh;display:flex;flex-direction:column;}
.sheet-head{display:flex;align-items:center;justify-content:space-between;padding:16px 16px 12px;border-bottom:1px solid var(--border);background:#fff;border-radius:22px 22px 0 0;gap:8px;}
.sheet-head h3{margin:0;font-size:15px;font-weight:700;}
.sheet-close{width:32px;height:32px;border-radius:9px;border:1px solid var(--border);background:#fff;cursor:pointer;font-size:14px;color:var(--muted);flex-shrink:0;}
.sheet-body{padding:16px 16px calc(24px + var(--pad-bot));overflow-y:auto;}

/* ---------- STAGE STEPPER ---------- */
.stepper{display:flex;gap:4px;overflow-x:auto;padding:2px 0 8px;}
.step{flex-shrink:0;font-size:10.5px;font-weight:600;padding:6px 10px;border-radius:8px;background:#EEF2F6;color:var(--muted);border:1px solid transparent;}
.step.done{background:var(--success-bg);color:var(--green-dark);}
.step.cur{background:var(--navy);color:#fff;border-color:var(--navy);}
.step.bad{background:var(--danger-bg);color:var(--danger);}

.stage-action{background:linear-gradient(135deg,var(--navy),var(--navy-2));color:#fff;border-radius:15px;padding:14px;margin-bottom:14px;}
.stage-action .sa-lbl{font-size:10.5px;color:rgba(255,255,255,.65);font-weight:600;}
.stage-action .sa-title{font-family:'Sora';font-weight:700;font-size:15px;margin:4px 0 3px;}
.stage-action .sa-desc{font-size:11.5px;color:rgba(255,255,255,.75);line-height:1.5;}
.stage-action .btn{margin-top:11px;}

/* ---------- DETAIL BLOCKS ---------- */
.blk{background:#fff;border:1px solid var(--border);border-radius:14px;margin-bottom:11px;overflow:hidden;}
.blk-head{display:flex;align-items:center;justify-content:space-between;padding:12px 13px;cursor:pointer;gap:8px;}
.blk-head .bh-l{display:flex;align-items:center;gap:8px;min-width:0;}
.blk-head h4{margin:0;font-size:13px;font-weight:700;}
.blk-badge{font-size:10px;font-weight:700;padding:2px 7px;border-radius:6px;background:var(--slate-bg);color:var(--slate);}
.blk-body{padding:0 13px 13px;border-top:1px solid #F1F4F8;padding-top:11px;}
.kv{display:flex;justify-content:space-between;gap:12px;padding:6px 0;font-size:12.5px;border-bottom:1px solid #F5F7FA;}
.kv:last-child{border-bottom:none;}
.kv .k{color:var(--muted);flex-shrink:0;}
.kv .v{font-weight:600;text-align:right;word-break:break-word;}

/* ---------- DOC CHECKLIST ---------- */
.doc-group-title{font-size:11px;font-weight:700;color:var(--muted);margin:13px 0 7px;}
.doc-group-title:first-child{margin-top:0;}
.doc-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border:1px solid var(--border);border-radius:11px;margin-bottom:7px;cursor:pointer;background:#fff;}
.doc-item.on{background:var(--success-bg);border-color:#BFE5D3;}
.doc-box{width:20px;height:20px;border-radius:6px;border:2px solid #CBD5E0;display:flex;align-items:center;justify-content:center;font-size:12px;color:#fff;flex-shrink:0;}
.doc-item.on .doc-box{background:var(--green);border-color:var(--green);}
.doc-name{font-size:12.5px;font-weight:500;flex:1;}
.doc-item.on .doc-name{font-weight:600;color:var(--green-dark);}
.doc-progress{display:flex;align-items:center;gap:10px;margin-bottom:12px;}
.doc-progress .dp-track{flex:1;height:8px;border-radius:5px;background:#EEF2F6;overflow:hidden;}
.doc-progress .dp-fill{height:100%;background:var(--green);border-radius:5px;}
.doc-progress .dp-txt{font-size:12px;font-weight:700;font-family:'Sora';}

/* ---------- LENDER CARD ---------- */
.lender-card{border:1px solid var(--border);border-radius:14px;padding:12px;margin-bottom:10px;background:#fff;}
.lender-card.sel{border-color:var(--green);background:var(--success-bg);}
.lender-card.sel .lh-name{color:var(--green-dark);}
.lh{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;}
.lh-name{font-weight:700;font-size:13.5px;}
.lh-prod{font-size:11px;color:var(--muted);margin-top:2px;}
.lgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px 12px;margin-top:10px;}
.lgrid div{font-size:11.5px;color:var(--muted);}
.lgrid div b{color:var(--ink);font-weight:600;display:block;font-size:12px;margin-top:1px;}
.fit{font-size:10px;font-weight:700;padding:3px 7px;border-radius:6px;white-space:nowrap;}
.fit.ok{background:var(--success-bg);color:var(--green-dark);}
.fit.no{background:var(--warn-bg);color:var(--warn);}
.lender-more{font-size:11.5px;color:var(--muted);line-height:1.6;margin-top:9px;padding-top:9px;border-top:1px dashed var(--border);}
.lender-more b{color:var(--ink);}
.lender-acts{display:flex;gap:7px;margin-top:10px;}

/* ---------- TIMELINE ---------- */
.tl-item{display:flex;gap:10px;padding-bottom:13px;position:relative;}
.tl-item:last-child{padding-bottom:0;}
.tl-dot{width:9px;height:9px;border-radius:50%;background:var(--blue);margin-top:4px;flex-shrink:0;position:relative;z-index:1;}
.tl-item:not(:last-child)::before{content:"";position:absolute;left:4px;top:13px;bottom:0;width:1px;background:var(--border);}
.tl-txt{font-size:12.5px;line-height:1.45;}
.tl-time{font-size:10.5px;color:var(--muted);margin-top:2px;}

/* ---------- SEARCH / FILTER ---------- */
.search-row{display:flex;gap:9px;margin-bottom:12px;}
.search-wrap{flex:1;position:relative;}
.search-wrap input{width:100%;padding:11px 12px 11px 36px;border:1px solid var(--border);border-radius:12px;font-size:13.5px;background:#fff;}
.search-wrap svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--muted);}
.filter-trigger-btn{width:44px;border-radius:12px;border:1px solid var(--border);background:#fff;cursor:pointer;position:relative;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.filter-count{position:absolute;top:-5px;right:-5px;background:var(--gold);color:var(--navy);font-size:9.5px;font-weight:800;border-radius:9px;min-width:17px;height:17px;display:flex;align-items:center;justify-content:center;padding:0 4px;}
.active-filters-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:11px;align-items:center;}
.fpill{background:var(--navy);color:#fff;font-size:11px;font-weight:600;padding:5px 9px;border-radius:8px;display:flex;align-items:center;gap:6px;}
.fpill span{cursor:pointer;opacity:.7;}
.clear-all-link{background:none;border:none;color:var(--blue);font-size:11.5px;font-weight:600;cursor:pointer;}
.filter-label{font-size:11.5px;font-weight:700;color:var(--muted);margin:15px 0 7px;}
.filter-label:first-child{margin-top:0;}

/* ---------- WIZARD ---------- */
.wiz-progress-wrap{margin-bottom:16px;}
.wiz-progress-top{display:flex;justify-content:space-between;font-size:11.5px;color:var(--muted);margin-bottom:6px;gap:8px;}
.wp-title{font-weight:700;color:var(--ink);}
.wiz-progress-track{height:5px;background:#E6EBF1;border-radius:4px;overflow:hidden;}
.wiz-progress-fill{height:100%;background:linear-gradient(90deg,var(--gold),var(--gold-dark));border-radius:4px;transition:width .3s;}
.wiz-nav-row{display:flex;gap:9px;margin-top:18px;}
.wiz-nav-row .btn{flex:1;}
.review-block{background:#fff;border:1px solid var(--border);border-radius:13px;padding:12px;margin-bottom:13px;}
.rb-title{font-size:11.5px;font-weight:700;color:var(--muted);margin-bottom:8px;}
.review-row{display:flex;justify-content:space-between;gap:12px;font-size:12.5px;padding:5px 0;}
.review-row .rk{color:var(--muted);} .review-row .rv{font-weight:600;text-align:right;}
.wiz-denied-banner{background:var(--warn-bg);border:1px solid #F0DCB8;color:#8A5A14;font-size:12px;padding:11px;border-radius:11px;margin-bottom:13px;line-height:1.5;}

/* ---------- SETTINGS ---------- */
.set-item{display:flex;align-items:center;justify-content:space-between;padding:13px;background:#fff;border:1px solid var(--border);border-radius:13px;margin-bottom:9px;cursor:pointer;gap:10px;}
.set-item .si-l{display:flex;gap:11px;align-items:center;min-width:0;}
.set-ico{width:34px;height:34px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0;}
.set-item .si-title{font-size:13px;font-weight:700;}
.set-item .si-sub{font-size:11px;color:var(--muted);margin-top:2px;}
.prod-edit{border:1px solid var(--border);border-radius:12px;padding:11px;margin-bottom:10px;background:#fff;}
.prod-edit-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;}
.prod-edit-head b{font-size:12.5px;}

/* ---------- BOTTOM NAV ---------- */
